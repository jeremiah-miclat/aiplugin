# Gradle build output/caches (Fabric/Forge modules) — large (Loom's cache alone can be 50-100MB+,
# including cached Minecraft jars), fully regeneratable from source, and machine-specific. The
# actual deliverable jars belong in releases/ (via release.sh), not here.
**/.gradle/
**/build/
**/bin/

# Same idea for Maven modules, going forward — note this does NOT retroactively untrack
# paper/target/, which was already committed before this file existed; it only stops NEW Maven
# modules from being tracked the same way.
**/target/

# NeoForge/Fabric local dev-server run dirs (world save, server.properties, config with real API
# keys) — generated by runServer/runClient, machine-specific, never meant to be shared.
**/run/

# Personal Claude Code permission overrides, not shared with the team
.claude/settings.local.json

# Empty auto-generated VS Code stubs from NeoForge/Fabric Gradle IDE integration
**/.vscode/

# Fabric server launch artifacts, sometimes generated at repo root instead of a run/ dir
/fabric-server-launch.jar
/libraries/

# Node dependencies — regenerate with npm install
node_modules/

# ai-bot-openrouter local secrets and runtime state — see config.example.json for the template
ai-bot-openrouter/config.json
ai-bot-openrouter/ai-bot.log
ai-bot-openrouter/state.json
